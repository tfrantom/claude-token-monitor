# Normalize to LF in the repository. Without this, cloning on Windows with
# core.autocrlf=true checks everything out as CRLF and any later edit on
# another platform shows up as a whole-file diff.
#
# Working-copy endings are left to the platform: nothing in this suite parses
# its own source, and both Node and PowerShell 5.1 read either.
* text=auto

# Explicitly text, so a checkout never gets these wrong.
*.js    text
*.lua   text
*.json  text
*.md    text
*.yml   text

# PowerShell 5.1 predates PowerShell Core and is the only shell here; CRLF is
# what it is written and tested against on Windows.
*.ps1   text eol=crlf
